THREADS_USER_ID=
THREADS_TOKEN=
WORKSPACE_API_URL=https://your-app.vercel.app
WORKSPACE_API_KEY=

# YouTube и TikTok сами по себе токены не хранят — только ключи приложения,
# которыми планировщик обновляет access_token, сохранённый в базе через
# /settings/social. Без них подключённые аккаунты просто перестанут
# продлеваться (см. youtube_account/tiktok_account в scheduler.py).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
